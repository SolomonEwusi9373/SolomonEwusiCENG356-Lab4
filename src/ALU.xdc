# CLK100MHZ

set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]

create_clock -period 10.000 -name CLK -waveform {0.000 5.000} [get_ports CLK]
set_false_path -from [get_pins {{LED/Divide/CntL_reg[0]/C} {LED/Divide/CntL_reg[1]/C}}] -to [get_ports {Pattern[*]}]
set_false_path -from [get_pins {{LED/Divide/CntL_reg[0]/C} {LED/Divide/CntL_reg[1]/C}}] -to [get_ports {Anodes[*]}]

set_input_delay -clock [get_clocks CLK] -min -add_delay 0.500 [get_ports RST]
set_input_delay -clock [get_clocks CLK] -max -add_delay 1.500 [get_ports RST]
